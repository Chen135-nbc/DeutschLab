  "design_intent": {
    "navigation": "按A1自学框架8个板块、68个单元构造树形导航；具体任务型技能叶片以后按练习证据增量添加",
    "shared_ids": "节点通过source_catalog_id或outline_refs引用自学框架内容；不要复制课程内容",
    "two_axes": "学习覆盖状态和实际运用能力状态必须分开",
    "no_auto_mastery": "仅学习、匹配/选择题正确或通关剧情都不能自动证明口语能力",
    "replay": "同一副本重复训练时追加证据，不覆盖历史成绩"
  },
  "progress_model_proposal": {
    "storage": "separate_user_progress_records",
    "learning_coverage_status": [
      "not_started",
      "partially_covered",
      "studied"
    ],
    "application_status": [
      "not_assessed",
      "in_practice",
      "self_reported",
      "evidence_supported"
    ],
    "learning_node_key": "source_catalog_id",
    "ability_node_key": "id",
    "outline_coverage_field": "covered_outline_ids",
    "evidence_field": "assessment_evidence_ids",
    "default_on_import": {
      "learning_coverage_status": "not_started",
      "application_status": "not_assessed"
    }
  },
