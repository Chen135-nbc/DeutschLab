      "outlineId": "A1-B03-U01-P02",
      "title": "问数量、问价格与核对",
      "summary": "用短问句确认数量和价格，再把读到的信息写下来。",
      "cardIds": [
        "ext.a1.numbers.card.quantity",
        "ext.a1.numbers.card.price",
        "ext.a1.numbers.card.confirm"
      ]
    },
    {
      "outlineId": "A1-B03-U01-P03",
      "title": "十位个位的生活应用",
      "summary": "区分 16/60、17/70 以及两位数先个位后十位的顺序。",
      "cardIds": [
        "ext.a1.numbers.card.order",
        "ext.a1.numbers.card.pitfalls"
